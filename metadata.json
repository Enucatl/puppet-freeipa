{
  "name": "Enucatl-freeipa",
  "version": "7.1.0",
  "author": "Enucatl",
  "summary": "Enroll supported Ubuntu and Debian 13 hosts as FreeIPA clients",
  "license": "GPL-3.0-only",
  "source": "https://github.com/Enucatl/puppet-freeipa",
  "project_page": "https://github.com/Enucatl/puppet-freeipa",
  "issues_url": "https://github.com/Enucatl/puppet-freeipa/issues",
  "dependencies": [
    {
      "name": "puppetlabs-stdlib",
      "version_requirement": ">= 9.0.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": ["24.04", "26.04"]
    },
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": ["13"]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "pdk-version": "3.4.0",
  "template-url": "pdk-default#3.4.0"
}
